# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docsign?retryWrites=true&w=majority

# JWT — use a random 64+ char string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# WebAuthn — must match your actual deployed domain
# Local dev:    localhost / http://localhost:3000
# Production:   your-api.onrender.com / https://your-app.vercel.app
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DocSign Platform
WEBAUTHN_ORIGIN=http://localhost:3000

# Frontend URL (for CORS and QR code links)
CLIENT_URL=http://localhost:3000


MONGODB_URI=mongodb+srv://atharva:Xt4fyxa%230g%5Ey%2AXJXYNyR@cluster0.dhyrg.mongodb.net/docsign?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=atharva_secret_key_123456789

JWT_EXPIRES_IN=7d

NODE_ENV=development

CLIENT_URL=http://localhost:3000